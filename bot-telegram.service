# Para rodar 24/7 num servidor Linux (ex.: Oracle Cloud Always Free).
# Ajuste User e os caminhos, copie para /etc/systemd/system/ e rode:
#   sudo systemctl daemon-reload && sudo systemctl enable --now bot-telegram
[Unit]
Description=Telegram keyword monitor
After=network-online.target
Wants=network-online.target

[Service]
User=ubuntu
WorkingDirectory=/home/ubuntu/bot-telegram
ExecStart=/home/ubuntu/bot-telegram/.venv/bin/python monitor.py
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
