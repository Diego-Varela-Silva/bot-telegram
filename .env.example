# Credenciais da SUA conta (https://my.telegram.org -> API development tools)
API_ID=123456
API_HASH=coloque_seu_api_hash

# Token do bot que vai te avisar (crie no @BotFather) e seu user id (@userinfobot)
BOT_TOKEN=123456789:AA...
NOTIFY_CHAT_ID=123456789

# Palavras-chave separadas por virgula (sem diferenciar maiusculas;
# espacos tambem casam com hifen ou nada: "apple watch" pega "applewatch" e "Apple-Watch")
KEYWORDS=apple watch,mac book
